{
  "name": "double-deno-mock",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env --unstable-worker-options src/main.ts",
    "dev": "deno run --allow-net --allow-read --allow-env --unstable-worker-options --watch src/main.ts",
    "prepare": "git config --local core.hooksPath .git-hooks",
    "test": "deno test --allow-net --allow-read --allow-env --unstable-worker-options"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.worker"]
  },
  "compile": {
    "exclude": ["tests/**"]
  },
  "imports": {
    "@hono": "jsr:@hono/hono@^4.13.1",
    "@hono/deno": "jsr:@hono/hono@^4.13.1/deno",
    "@hono/streaming": "jsr:@hono/hono@^4.13.1/streaming",
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@miscellaneous/commitlint": "jsr:@miscellaneous/commitlint@^0.3.2"
  },
  "fmt": {
    "useTabs": false,
    "indentWidth": 2,
    "lineWidth": 120,
    "singleQuote": true,
    "semiColons": false,
    "newLineKind": "lf",
    "include": ["src/**", "tests/**"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "include": ["src/**", "tests/**"]
  }
}
